{
  "$defs": {
    "Ticket": {
      "additionalProperties": false,
      "properties": {
        "terms": {
          "$ref": "#/$defs/TradeInput"
        },
        "participants": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Participants",
          "type": "object"
        }
      },
      "required": [
        "terms",
        "participants"
      ],
      "title": "Ticket",
      "type": "object"
    },
    "TradeInput": {
      "additionalProperties": false,
      "properties": {
        "trade_id": {
          "pattern": "^LT-[A-Za-z0-9-]{6,64}$",
          "title": "Trade Id",
          "type": "string"
        },
        "facility_id": {
          "title": "Facility Id",
          "type": "string"
        },
        "amount": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "title": "Amount",
          "type": "integer"
        },
        "price": {
          "pattern": "^\\d{1,3}(\\.\\d{1,6})?$",
          "title": "Price",
          "type": "string"
        },
        "seller": {
          "title": "Seller",
          "type": "string"
        },
        "buyer": {
          "title": "Buyer",
          "type": "string"
        },
        "trade_date": {
          "title": "Trade Date",
          "type": "string"
        },
        "settlement_date": {
          "title": "Settlement Date",
          "type": "string"
        }
      },
      "required": [
        "trade_id",
        "facility_id",
        "amount",
        "price",
        "seller",
        "buyer",
        "trade_date",
        "settlement_date"
      ],
      "title": "TradeInput",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "execution_id": {
      "pattern": "^[a-zA-Z0-9-]{8,100}$",
      "title": "Execution Id",
      "type": "string"
    },
    "ticket": {
      "$ref": "#/$defs/Ticket"
    },
    "approval": {
      "additionalProperties": true,
      "title": "Approval",
      "type": "object"
    }
  },
  "required": [
    "execution_id",
    "ticket",
    "approval"
  ],
  "title": "Propose",
  "type": "object"
}
